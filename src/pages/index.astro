---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="container">
      <p class="eyebrow">Travel Planning, Reimagined</p>
      <h1>Plan trips together.<br />Actually together.</h1>
      <p class="subhead">
        Tayo Na is a mobile-first travel planner for solo adventurers and groups
        who want to stop juggling spreadsheets and group chats.
      </p>
      <a href="https://tayona.app" class="btn btn-primary">Open the App</a>
    </div>
  </section>

  <!-- Features -->
  <section class="features">
    <div class="container">
      <div class="features-grid">
        <div class="feature-card">
          <span class="feature-icon">🗺️</span>
          <h3>Plan before you book</h3>
          <p>Add destinations, explore activities, and estimate costs before committing to anything.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">👥</span>
          <h3>Built for groups</h3>
          <p>Track members, split expenses, and keep everyone on the same page.</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">✈️</span>
          <h3>From planning to takeoff</h3>
          <p>Confirm your trip when you're ready and your plan becomes your itinerary.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- How It Works -->
  <section class="how-it-works">
    <div class="container">
      <h2>How it works</h2>
      <div class="steps">
        <div class="step">
          <div class="step-number">1</div>
          <div class="step-content">
            <h3>Create a trip</h3>
            <p>Solo or with your group — set up your trip in seconds.</p>
          </div>
        </div>
        <div class="step-connector" aria-hidden="true"></div>
        <div class="step">
          <div class="step-number">2</div>
          <div class="step-content">
            <h3>Plan destinations, activities, and budget</h3>
            <p>Collaborate in real time, explore options, and track costs together.</p>
          </div>
        </div>
        <div class="step-connector" aria-hidden="true"></div>
        <div class="step">
          <div class="step-number">3</div>
          <div class="step-content">
            <h3>Confirm and go</h3>
            <p>Your itinerary is ready. Time to pack.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Pull Quote -->
  <section class="quote-section">
    <div class="container">
      <blockquote>
        "No more Excel spreadsheets.<br />No more 'what's the plan?' messages."
      </blockquote>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="cta-section">
    <div class="container">
      <h2>Ready to travel smarter?</h2>
      <a href="https://tayona.app" class="btn btn-primary">Start Planning Free</a>
      <p class="cta-sub">Free to use. Premium features coming soon.</p>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div class="container">
      <img src="/tayona-logo.svg" alt="Tayo Na" class="footer-logo" />
      <p class="footer-tagline">Let's Go Together</p>
      <a href="https://tayona.app" class="footer-link">tayona.app</a>
    </div>
  </footer>
</Layout>

<style>
  /* Layout */
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero */
  .hero {
    background: var(--bg);
    padding: 6rem 0 5rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--accent);
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    color: var(--text);
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  .subhead {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--secondary);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 0.85rem 2rem;
    border-radius: 8px;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    transition: opacity 0.15s ease;
    text-decoration: none;
  }

  .btn:hover {
    opacity: 0.88;
    text-decoration: none;
  }

  .btn-primary {
    background: var(--accent);
    color: #1A1B2E;
  }

  /* Features */
  .features {
    padding: 5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 2rem;
  }

  .feature-icon {
    font-size: 2rem;
    display: block;
    margin-bottom: 1rem;
  }

  .feature-card h3 {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.6rem;
  }

  .feature-card p {
    color: var(--secondary);
    font-size: 0.95rem;
    line-height: 1.65;
  }

  /* How It Works */
  .how-it-works {
    padding: 5rem 0;
    border-bottom: 1px solid var(--border);
  }

  .how-it-works h2 {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text);
    text-align: center;
    margin-bottom: 3rem;
  }

  .steps {
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 640px;
    margin: 0 auto;
  }

  .step {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .step-number {
    flex-shrink: 0;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--accent);
    color: #1A1B2E;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-content {
    padding-bottom: 0.25rem;
  }

  .step-content h3 {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    margin-bottom: 0.35rem;
  }

  .step-content p {
    color: var(--secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .step-connector {
    width: 2px;
    height: 2rem;
    background: var(--border);
    margin-left: 1.2rem;
  }

  /* Quote */
  .quote-section {
    padding: 5rem 0;
    border-bottom: 1px solid var(--border);
    text-align: center;
  }

  blockquote {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: clamp(1.3rem, 3vw, 1.85rem);
    font-weight: 700;
    color: var(--accent);
    line-height: 1.45;
    max-width: 700px;
    margin: 0 auto;
  }

  /* Final CTA */
  .cta-section {
    padding: 5rem 0;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .cta-section h2 {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text);
    margin-bottom: 2rem;
  }

  .cta-sub {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--secondary);
  }

  /* Footer */
  .footer {
    padding: 3rem 0;
    text-align: center;
  }

  .footer-logo {
    width: 80px;
    height: auto;
    margin: 0 auto 0.5rem;
  }

  .footer-tagline {
    font-size: 0.875rem;
    color: var(--secondary);
    margin-bottom: 0.75rem;
  }

  .footer-link {
    font-size: 0.875rem;
    color: var(--accent);
  }

  /* Responsive */
  @media (min-width: 768px) {
    .steps {
      flex-direction: row;
      align-items: flex-start;
      max-width: 100%;
      gap: 0;
    }

    .step {
      flex: 1;
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .step-connector {
      width: 3rem;
      height: 2px;
      margin: 1.25rem 0 0;
      align-self: flex-start;
      flex-shrink: 0;
    }

    .step-content {
      padding-bottom: 0;
    }
  }
</style>
