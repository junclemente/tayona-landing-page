---
---

<section class="hero">
  <div class="container">
    <p class="eyebrow">Travel Planning, Reimagined</p>
    <h1>Plan trips together.<br />Actually together.</h1>
    <p class="subhead">
      Tayo Na is a mobile-first travel planner for solo adventurers and groups
      who want to stop juggling spreadsheets and group chats.
    </p>
    <a href="https://tayona.app" class="btn btn-primary">Open the App</a>
  </div>
</section>

<style>
  .hero {
    background: var(--bg);
    padding: 6rem 0 5rem;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .eyebrow {
    font-family: "Inter", system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--primary);
    margin-bottom: 1.25rem;
  }

  .hero h1 {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: clamp(2.4rem, 6vw, 4rem);
    font-weight: 800;
    color: var(--text);
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }

  .subhead {
    font-size: clamp(1rem, 2vw, 1.2rem);
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }
</style>
