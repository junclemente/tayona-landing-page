<section class="cta-section">
  <div class="container">
    <h2>Ready to travel smarter?</h2>
    <a href="https://tayona.app" class="btn btn-primary"
      >Start Planning Free</a
    >
    <p class="cta-sub">Free to use. Premium collaboration features coming soon.</p>
    <p class="cta-privacy">
      🔒 No account required for solo planning. Trip data stays on your device.
      A free account unlocks sharing and group collaboration.
    </p>
  </div>
</section>

<style>
  .cta-section {
    padding: 5rem 0;
    text-align: center;
    border-bottom: 1px solid var(--border);
  }

  .cta-section h2 {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text);
    margin-bottom: 2rem;
  }

  .cta-sub {
    margin-top: 1.25rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .cta-privacy {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    color: var(--text-muted);
  }
</style>
