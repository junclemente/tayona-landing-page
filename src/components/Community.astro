<section class="community-section">
  <div class="container">
    <h2>Built for your <em>kaibigan</em> &amp; <em>kapamilya</em></h2>
    <p>
      <em>Kaibigan</em> means friend. <em>Kapamilya</em> means family. Tayo Na
      is built for both — because the best trips are the ones you take with the
      people who matter most.
    </p>
  </div>
</section>

<style>
  .community-section {
    padding: 4rem 0;
    border-bottom: 1px solid var(--border);
    text-align: center;
  }

  .community-section h2 {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    color: var(--text);
    margin-bottom: 1.25rem;
  }

  .community-section p {
    font-size: clamp(1rem, 2vw, 1.15rem);
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.75;
  }

  .community-section em {
    font-style: italic;
    color: var(--text);
  }
</style>
